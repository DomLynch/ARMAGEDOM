{
  "name": "armagedom-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8890",
    "build": "vite build --base=./ && node scripts/verify-assets.mjs --actors assets/manifest-hollow.json --audio audio/manifest.json --prune",
    "test": "node --test --test-concurrency=2 tests/*.test.js",
    "check": "node ../scripts/verify_web.mjs",
    "verify:assets": "node scripts/verify-assets.mjs --actors assets/manifest-hollow.json --audio audio/manifest.json",
    "test:packaging": "node --test scripts/verify-assets.test.mjs",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\""
  },
  "dependencies": {
    "@frankendom/physics": "https://codeload.github.com/DomLynch/physics/tar.gz/909c5416102e9505ff1eb3106b7bef6338f7910b",
    "three": "0.182.0"
  },
  "devDependencies": {
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "vite": "6.4.4"
  }
}
