{
  "schema_version": 1,
  "modeScale": { "high": 1, "low": 0.5, "off": 0 },
  "hitStopCapSeconds": 0.1,
  "maxShakeMagnitude": 5,
  "shakeSecondsRange": [0.3, 0.5],
  "shake": { "pixelsPerUnit": 2, "frequencyX": 31, "frequencyY": 43 },
  "view": {
    "default": "standard",
    "storageKey": "armagedom.view",
    "presets": [
      { "id": "standard", "multiplier": 1 },
      { "id": "close", "multiplier": 1.15 }
    ]
  },
  "text": { "viewLabel": "View", "presets": { "standard": "Standard", "close": "Close" } },
  "rules": [
    {
      "id": "boss-hit-taken",
      "on": ["hit"],
      "victim": "enemy",
      "flags": ["bossProfile"],
      "excludeWeapons": ["flamethrower"],
      "cooldown": 0.3,
      "hitStop": 0.07,
      "shake": { "magnitude": 1, "seconds": 0.3 }
    },
    {
      "id": "enemy-hit",
      "on": ["hit"],
      "victim": "enemy",
      "excludeWeapons": ["flamethrower"],
      "shake": { "magnitude": 0.5, "seconds": 0.3 }
    },
    {
      "id": "player-hurt",
      "on": ["hit"],
      "victim": "player",
      "blocked": false,
      "minAmount": 0,
      "shake": { "magnitude": 1, "seconds": 0.3 }
    },
    {
      "id": "player-big-hit",
      "on": ["hit"],
      "victim": "player",
      "blocked": false,
      "overHpShare": 0.2,
      "hitStop": 0.08,
      "shake": { "magnitude": 1, "seconds": 0.3 }
    },
    {
      "id": "boss-strikes-player",
      "on": ["hit"],
      "victim": "player",
      "blocked": false,
      "minAmount": 0,
      "attackerFlags": ["bossProfile"],
      "shake": { "magnitude": 5, "seconds": 0.5 }
    },
    {
      "id": "player-blocked",
      "on": ["hit"],
      "victim": "player",
      "blocked": true,
      "shake": { "magnitude": 0.5, "seconds": 0.3 }
    },
    {
      "id": "kill",
      "on": ["death"],
      "victim": "enemy",
      "shake": { "magnitude": 1, "seconds": 0.3 }
    },
    {
      "id": "heavy-kill",
      "on": ["death"],
      "victim": "enemy",
      "flags": ["star", "markedHunter", "finisher", "bossProfile"],
      "cooldown": 0.2,
      "hitStop": 0.07
    },
    {
      "id": "parry",
      "on": ["parry"],
      "victim": "player",
      "hitStop": 0.1,
      "shake": { "magnitude": 1, "seconds": 0.3 }
    },
    {
      "id": "guard-break",
      "on": ["guard-break"],
      "victim": "player",
      "hitStop": 0.1,
      "shake": { "magnitude": 1, "seconds": 0.3 }
    },
    {
      "id": "explosion",
      "on": ["grenade-blast", "trap-crate-blast", "boss-rocket-blast"],
      "victim": "any",
      "range": 14,
      "shake": { "magnitude": 2, "seconds": 0.4 }
    },
    {
      "id": "boss-defeated",
      "on": ["boss-defeated"],
      "victim": "any",
      "shake": { "magnitude": 5, "seconds": 0.5 }
    }
  ]
}
