{
  "schema_version": 1,
  "enabled": true,
  "storageKey": "armagedom.uiscale",
  "default": "normal",
  "cssVar": "--ui-user-scale",
  "bodyClass": "ui-scaled",
  "bounds": { "min": 0.75, "max": 1.5 },
  "roundTo": 100,
  "steps": [
    { "id": "small", "scale": 0.85 },
    { "id": "normal", "scale": 1 },
    { "id": "large", "scale": 1.15 },
    { "id": "largest", "scale": 1.3 }
  ],
  "fit": {
    "portrait": [
      { "axis": "width", "fixedPx": 40, "scalablePx": 308 },
      { "axis": "height", "fixedPx": 260, "scalablePx": 216 },
      { "axis": "height", "fixedPx": 406, "scalablePx": 136 }
    ],
    "landscape": [
      { "axis": "width", "fixedPx": 140, "scalablePx": 354 },
      { "axis": "height", "fixedPx": 40, "scalablePx": 258 },
      { "axis": "height", "fixedPx": 260, "scalablePx": 136 }
    ]
  },
  "text": {
    "label": "Controls size",
    "steps": { "small": "Small", "normal": "Normal", "large": "Large", "largest": "Largest" }
  }
}
