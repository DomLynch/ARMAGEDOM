{
  "schema_version": 1,
  "note": "Sound hooks: game events to small synthesized cue rows, layered on the donor cues (donor-audio.js). A row says which event it answers (event + match), how loud (gain), how varied (pitchVariance), how often (minGapSeconds, voices per row), how important (priority 1 to 9, the higher wins when the mix is full) and what it sounds like (tone and/or noise). mix.maxVoices caps hook voices at once, mix.maxPerBatch caps cues per frame; hearingRange (metres) fades a cue with distance. match keys compare against the event, plus target (player, boss or enemy) and lethal. A row with enabled false is inert (a flagged TODO). Off switch: ?sound=0 (hooks only; the mute switch and mode still apply to everything).",
  "flagParam": "sound",
  "offValue": "0",
  "defaultOn": true,
  "mix": { "maxVoices": 5, "maxPerBatch": 3, "hearingRange": 16, "farGain": 0.25 },
  "burn": {
    "enabled": true,
    "note": "Looping crackle while a flamed actor burns (flameBurnUntil, the same actors as burnPresentation.json; it also follows ?burn=0). Level = burning actors in hearingRange, capped by burnPresentation.maxActors.",
    "hearingRange": 12,
    "gain": 0.03,
    "gainPerActor": 0.012,
    "cutoff": 2200,
    "lfoHz": 9,
    "lfoDepth": 0.6,
    "rampSeconds": 0.25
  },
